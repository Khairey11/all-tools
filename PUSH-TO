@echo off
setlocal EnableDelayedExpansion
title One-Command GitHub Push
color 0B
cd /d "D:\AI\All TOols Folder"

echo =====================================================
echo   Creating repo + branch + pushing to GitHub
echo =====================================================
echo.

where git >nul 2>&1 || (
    echo [ERROR] Git not installed. Get it from https://git-scm.com/
    pause & exit /b 1
)

if not exist ".git" (
    echo [1/4] git init...
    git init
    git branch -M main
)

echo [2/4] Creating branch feature/gif-compressor...
git checkout -B feature/gif-compressor

echo [3/4] Committing all changes...
git add -A
git commit -m "feat: real animated GIF compressor (target-size, quality-first)" -m "WebCodecs decode + gifenc encode. Quality-first pipeline: lossless re-encode, frame-rate, colors, adaptive scale with budget claw-back. Auto re-compress on settings change. Local-only PDF backend proxy."
if errorlevel 1 echo [INFO] Nothing new to commit.

echo [4/4] Pushing...
git push -u origin feature/gif-compressor

if errorlevel 1 (
    if "!REMOTE_SET!"=="1" goto :help
    echo.
    echo No remote configured yet.
    set /p REPO="Paste your GitHub repo URL (https://github.com/USER/REPO.git): "
    if "!REPO!"=="" ( echo [ERROR] Empty URL. & pause & exit /b 1 )
    git remote add origin !REPO!
    git push -u origin feature/gif-compressor
    if errorlevel 1 goto :help
)

color 0A
echo.
echo =====================================================
echo   SUCCESS - pushed branch feature/gif-compressor
echo =====================================================
pause
exit /b 0

:help
color 0E
echo.
echo =====================================================
echo   Push failed. Fix one of these then re-run:
echo   1. Not logged in? Run:  git credential-manager github login
echo   2. Wrong URL? Run:     git remote set-url origin NEW_URL
echo   3. Repo must exist at github.com first (github.com/new)
echo =====================================================
pause
exit /b 1